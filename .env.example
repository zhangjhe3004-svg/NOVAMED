# MediCode 后端环境变量示例（复制为 backend/.env 使用）
APP_NAME=MediCode Smart Medical System
APP_VERSION=1.0.0
DEBUG=true
ENABLE_TASK_SCHEDULER=true
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BACKEND_PORT=18001
DATABASE_URL=sqlite:///./data/medical_system.db
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=["http://localhost:3051","http://localhost:3005"]
MONGODB_URL=mongodb://localhost:27017


# ===== 医院级安全 =====
# PHI 字段级加密密钥（Base64）。生成：
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 生产环境必须设置为真实随机值，并妥善离线保管；丢失后已加密数据无法解密。
FERNET_KEY=
# 登录等敏感接口限流（次数 / 秒窗口）
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW=60
ENABLE_SECURITY_HEADERS=true


# ===== 多租户数据存储服务 =====
# 生产切换到 PostgreSQL 承载 1 万并发；开发留空则用本地 SQLite（backend/data/storage.db）
STORAGE_DATABASE_URL=
STORAGE_POOL_SIZE=20
STORAGE_MAX_OVERFLOW=40
STORAGE_POOL_TIMEOUT=30
